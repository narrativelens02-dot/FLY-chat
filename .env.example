# =============================================
# FLYchat — Environment Variables Template
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit .env ke git!
# =============================================

# ─── Neon Postgres ────────────────────────────
# Dapatkan dari: https://neon.tech → Project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── JWT Secret ───────────────────────────────
# Buat random string panjang, contoh:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter

# ─── Server ───────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Upload ───────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ─── Google OAuth ─────────────────────────────
# Dapatkan dari: https://console.cloud.google.com
# APIs & Services → Credentials → OAuth 2.0 Client ID → Web application
# Authorized JS origins: http://localhost:3000, https://domain-produksi.com
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ─── Cloudinary (file upload cloud persistent) ──
# Dapatkan dari: https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP Email (untuk forgot/reset password) ───
# Gmail: aktifkan App Password di myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=FLYchat <your_email@gmail.com>

# ─── Frontend URL ─────────────────────────────
# Untuk link reset password dalam email
FRONTEND_URL=http://localhost:3000
